# Copy to .env for local development. Never commit .env.

# --- Generation (optional): without a key, answers fall back to a local retrieval preview
# and SQL questions explain that Claude is needed to write the query.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
RAG_JUDGE_MODEL=claude-sonnet-5
RAG_MAX_OUTPUT_TOKENS=2048
RAG_LLM_TIMEOUT_SECONDS=60

# --- Data & index (paths are relative to the repository root unless absolute)
RAG_DOCS_DIR=data/documents
RAG_INDEX_PATH=data/index/index.json
RAG_SQL_DB_PATH=data/index/retail.db
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120

# --- Retrieval: tfidf | bm25 | dense | hybrid
RAG_RETRIEVER=hybrid
RAG_TOP_K=4
# Evidence-gate threshold on dense similarity. Leave unset to use the retriever's
# calibrated default (0.575 for dense/hybrid with bge-small; see evals/baselines).
# RAG_MIN_SCORE=
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pre-downloaded model directory for air-gapped deployments (optional)
# RAG_EMBEDDING_MODEL_PATH=
# RAG_EMBEDDING_CACHE_DIR=
# Second-stage reranking: none | cross-encoder
RAG_RERANKER=none
RAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_RERANK_CANDIDATES=20
# Restrict retrieval to the company / fiscal year a question names
RAG_METADATA_FILTERS=true
# Dense vectors in-process (memory) or in Postgres + pgvector (HNSW)
RAG_VECTOR_STORE=memory
# RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- Routing between documents (RAG) and the operational database (SQL)
RAG_ROUTER_ENABLED=true

# --- API protection. Comma-separated keys; unset disables auth (local development only).
# RAG_API_KEYS=change-me-1,change-me-2
RAG_RATE_LIMIT_PER_MINUTE=60
RAG_RATE_LIMIT_BURST=10

# --- Observability
LOG_LEVEL=INFO
LOG_FORMAT=text
# Tracing: off | console | otlp. For otlp, the standard OpenTelemetry variables apply, e.g.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 public:secret key>
RAG_TRACING=off
